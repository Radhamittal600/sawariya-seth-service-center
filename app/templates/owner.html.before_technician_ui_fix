async function ownerFetch(endpoint) {
    const response = await fetch(endpoint);

    if (!response.ok) {
        let message = "API Error";
        try {
            const data = await response.json();
            message = data.error || message;
        } catch (_) {}
        throw new Error(message);
    }

    return await response.json();
}


function ownerEscape(value) {
    return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}


function ownerTable(containerId, columns, rows) {

    const box = document.getElementById(containerId);

    if (!box) return;

    if (!rows || rows.length === 0) {
        box.innerHTML =
            '<div class="empty-cell">📭 No data available</div>';
        return;
    }

    let html = '<div class="users-table-wrap"><table class="users-table">';
    html += "<thead><tr>";

    columns.forEach(column => {
        html += `<th>${ownerEscape(column.label)}</th>`;
    });

    html += "<th>Actions</th>";
    html += "</tr></thead><tbody>";

    rows.forEach(row => {

        html += "<tr>";

        columns.forEach(column => {

            let value = row[column.key];

            if (value === null || value === undefined || value === "") {
                value = "-";
            }

            html += `<td>${ownerEscape(value)}</td>`;
        });

        html += "</tr>";
    });

    html += "</tbody></table></div>";

    box.innerHTML = html;
}


