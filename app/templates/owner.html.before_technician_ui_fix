<script>
function panel(id, btn) {
    const panels = document.querySelectorAll(".panel");

    panels.forEach(function(p) {
        p.style.display = "none";
        p.classList.remove("active-panel");
    });

    const target = document.getElementById(id);

    if (!target) {
        console.warn("Panel not found:", id);
        return;
    }

    target.style.display = "block";
    target.classList.add("active-panel");

    document.querySelectorAll(".nav button").forEach(function(b) {
        b.classList.remove("active");
    });

    if (btn) {
        btn.classList.add("active");
    }

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

    if (id === "users") {
        if (typeof loadOwnerUsers === "function") {
            loadOwnerUsers();
        }
    }

    if (id === "technicians") {
        ownerLive("technicians");
        if (typeof loadTechnicians === "function") {
            loadTechnicians();
        }
    }

    if (id === "sellers") {
        ownerLive("sellers");
        if (typeof loadSellers === "function") {
            loadSellers();
        }
    }

    if (id === "bookings") {
        ownerLive("bookings");
        if (typeof loadBookings === "function") {
            loadBookings();
        }
    }

    if (id === "paymentLive") {
        if (typeof loadPaymentCenter === "function") {
            loadPaymentCenter();
        }
    }

    if (id === "notifications") {
        if (typeof loadNotificationCenter === "function") {
            loadNotificationCenter();
        }
    }

    if (id === "analytics") {
        if (typeof loadAnalytics === "function") {
            loadAnalytics();
        }
    }

    if (OWNER_LIVE_ENDPOINTS && OWNER_LIVE_ENDPOINTS[id]) {
        ownerLive(id);
    }

    if (id === "refunds") {
        loadRefunds();
    }
}

async function get(url){
let r=await fetch(url),d=await r.json();
if(!r.ok)throw Error(d.error||"Request failed");
return d;
}

function render(data,id){
let box=document.getElementById(id);

if(!data?.length){
box.innerHTML='<span class="small">No records found.</span>';
return;
}

box.innerHTML=data.map(x=>{

let actions="";

if(id==="approvalData" && (x.role==="technician" || x.role==="seller") && x.status==="pending"){
actions=`
<div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap">
<button class="action" onclick="approveUser(${x.id})">✓ APPROVE</button>
<button class="action" style="background:linear-gradient(90deg,#ff5874,#ff315f)" onclick="rejectUser(${x.id})">✕ REJECT</button>
</div>`;
}

return `
<div class="row">
${Object.entries(x).map(([k,v])=>
`<div><b>${k}</b>: ${v??"-"}</div>`
).join("")}
${actions}
</div>`;

}).join("");
}

async function approveUser(id){

if(!confirm("Approve this user?")) return;

try{

let r=await fetch("/owner/users/"+id+"/approve",{
method:"POST",
headers:{"Content-Type":"application/json"}
});

let d=await r.json();

if(!r.ok) throw Error(d.error||"Approval failed");

alert("✓ User approved successfully");

loadApproval();

}catch(e){

alert(e.message);

}
}

async function rejectUser(id){

if(!confirm("Reject this user?")) return;

try{

let r=await fetch("/owner/users/"+id+"/reject",{
method:"POST",
headers:{"Content-Type":"application/json"}
});

let d=await r.json();

if(!r.ok) throw Error(d.error||"Rejection failed");

alert("✕ User rejected");

loadApproval();

}catch(e){

alert(e.message);

}
}

async function loadApproval(){

try{

let d=await get("/owner/pending-users");

render(d.users,"approvalData");

}catch(e){

alert(e.message);

}
}



async function loadAnalytics(){

try{

let d = await get("/owner/analytics/overview");

document.getElementById("aRevenue").textContent =
"₹"+Number(d.revenue||0).toLocaleString("en-IN");

document.getElementById("aBookings").textContent =
d.bookings || 0;

document.getElementById("aCompleted").textContent =
d.completed_bookings || 0;

document.getElementById("aActive").textContent =
d.active_bookings || 0;

document.getElementById("aCustomers").textContent =
d.customers || 0;

document.getElementById("aTechnicians").textContent =
d.technicians || 0;

document.getElementById("aSellers").textContent =
d.sellers || 0;

document.getElementById("aRating").textContent =
(d.average_rating || 0) + " / 5";

let total = Number(d.bookings || 0);
let completed = Number(d.completed_bookings || 0);

let health = total > 0
? Math.min(100, Math.round((completed / total) * 100))
: 0;

document.getElementById("healthBar").style.width =
health + "%";

document.getElementById("healthText").textContent =
"Booking completion health: " + health + "%";

let services = await get("/owner/analytics/services");

let box = document.getElementById("serviceAnalytics");

if(!services.services?.length){

box.innerHTML =
'<span class="small">No service analytics available yet.</span>';

return;

}

box.innerHTML =
"<h3>🛠️ Service Performance</h3>" +

services.services.map(x=>`

<div class="row">

<div>
<b>${x.name}</b>
</div>

<div class="small">
Bookings: ${x.bookings}
</div>

</div>

`).join("");

}catch(e){

console.error(e);

}

}

async function loadPaymentCenter(){

try{

let summary=await get("/owner/payments/summary");

document.getElementById("payRevenue").textContent=
"₹"+Number(summary.total_revenue||0).toLocaleString("en-IN");

document.getElementById("payCommission").textContent=
"₹"+Number(summary.commission||0).toLocaleString("en-IN");

document.getElementById("payPending").textContent=
"₹"+Number(summary.pending||0).toLocaleString("en-IN");

document.getElementById("payRefunds").textContent=
"₹"+Number(summary.refunds||0).toLocaleString("en-IN");

let data=await get("/owner/payments");

let box=document.getElementById("paymentData");

if(!data.payments?.length){

box.innerHTML=
'<span class="small">अभी कोई payment transaction मौजूद नहीं है।</span>';

return;

}

box.innerHTML=data.payments.map(x=>`

<div class="row">

<div><b>Transaction:</b> ${x.transaction_id||"-"}</div>
<div><b>Booking:</b> ${x.booking_id||"-"}</div>
