async function loadOwnerUsers() {

    const table = document.getElementById("ownerUsersTable");

    if (!table) return;

    const search = document.getElementById("umSearch")?.value || "";
    const role = document.getElementById("umRole")?.value || "";
    const status = document.getElementById("umStatus")?.value || "";

    table.innerHTML = `
        <tr>
            <td colspan="7" class="loading-cell">
                🔄 Loading users...
            </td>
        </tr>
    `;

    try {

        const params = new URLSearchParams();

        if (search) params.set("search", search);
        if (role) params.set("role", role);
        if (status) params.set("status", status);

        const [usersResponse, summaryResponse] = await Promise.all([
            fetch("/owner/users?" + params.toString()),
            fetch("/owner/users/summary")
        ]);

        if (!usersResponse.ok || !summaryResponse.ok) {
            throw new Error("Unable to load users");
        }

        const data = await usersResponse.json();
        const summary = await summaryResponse.json();

        document.getElementById("umTotal").textContent =
            summary.total || 0;

        document.getElementById("umCustomers").textContent =
            summary.customers || 0;

        document.getElementById("umTechnicians").textContent =
            summary.technicians || 0;

        document.getElementById("umSellers").textContent =
            summary.sellers || 0;

        document.getElementById("umPending").textContent =
            summary.pending || 0;

        document.getElementById("umBlocked").textContent =
            summary.blocked || 0;

        if (!data.users || data.users.length === 0) {
            table.innerHTML = `
                <tr>
                    <td colspan="7" class="empty-cell">
                        📭 No users found
                    </td>
                </tr>
            `;
            return;
        }

        table.innerHTML = data.users.map(user => {

            const roleClass =
                "role-" + escapeOwner(user.role);

            const statusClass =
                "status-" + escapeOwner(user.status);

            let action = "";

            if (user.role !== "owner") {

                if (user.status === "blocked") {
                    action = `
                        <button
                            class="user-action"
                            onclick="changeOwnerUserStatus(
                                ${user.id},
                                'unblock'
                            )">
                            ✅ Unblock
                        </button>
                    `;
                } else {
                    action = `
                        <button
                            class="user-action block-action"
                            onclick="changeOwnerUserStatus(
                                ${user.id},
                                'block'
                            )">
                            🚫 Block
                        </button>
                    `;
                }

            } else {
                action = `<span class="status-badge status-approved">OWNER</span>`;
            }

            return `
                <tr>

                    <td>#${user.id}</td>

                    <td>
                        <div class="user-name">
                            ${escapeOwner(user.name)}
                        </div>

                        <div class="user-sub">
                            ${escapeOwner(
                                user.business_name || ""
                            )}
                        </div>
                    </td>

                    <td>
                        ${escapeOwner(user.phone)}
                    </td>

                    <td>
                        <span class="role-badge ${roleClass}">
                            ${escapeOwner(user.role)}
                        </span>
                    </td>

                    <td>
                        <span class="status-badge ${statusClass}">
                            ${escapeOwner(user.status)}
                        </span>
                    </td>

                    <td>
                        ${escapeOwner(user.city || "-")}
                    </td>

                    <td>
                        <button
                            class="user-action"
                            onclick="viewOwnerUser(${user.id})">
                            👁️ View
                        </button>

                        ${action}
                    </td>

                </tr>
            `;

        }).join("");

    } catch (error) {

        table.innerHTML = `
            <tr>
                <td colspan="7" class="empty-cell">
                    ❌ ${escapeOwner(error.message)}
                </td>
            </tr>
        `;
    }
}


async function changeOwnerUserStatus(userId, action) {

    const confirmText =
        action === "block"
            ? "इस user को block करना है?"
            : "इस user को unblock करना है?";

    if (!confirm(confirmText)) return;

    try {

        const response = await fetch(
            `/owner/users/${userId}/${action}`,
            {
                method: "POST"
            }
        );

        const data = await response.json();

        if (!response.ok) {
            throw new Error(data.error || "Action failed");
        }

        await loadOwnerUsers();

    } catch (error) {

        const box =
            document.getElementById("ownerUsersMessage");

        box.className = "um-error";
        box.textContent = "❌ " + error.message;

        setTimeout(() => {
            box.className = "";
            box.textContent = "";
        }, 4000);
    }
}


