<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sawariya Seth • Super Owner</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Inter,Arial;background:#070816;color:#fff}
:root{--gold:#ffd54a;--pink:#ff4fd8;--cyan:#31e7ff;--purple:#9b6cff;--green:#42f59b;--red:#ff5874;--card:#11152a}
body:before{content:"";position:fixed;inset:0;z-index:-1;background:
radial-gradient(circle at 10% 10%,#ff3cac35,transparent 25%),
radial-gradient(circle at 90% 15%,#31e7ff30,transparent 25%),
radial-gradient(circle at 50% 100%,#7b2cff30,transparent 30%)}
.top{padding:16px;border-bottom:1px solid #ffffff18;background:#090b18dd;backdrop-filter:blur(18px);position:sticky;top:0;z-index:5}
.topin{max-width:1400px;margin:auto;display:flex;justify-content:space-between;align-items:center}
.logo{font-size:21px;font-weight:900}.logo span{color:var(--gold)}
.online{color:var(--green);font-size:12px}
.layout{max-width:1400px;margin:auto;padding:20px;display:grid;grid-template-columns:240px 1fr;gap:18px}
.side,.hero,.card,.panel{background:#11152acc;border:1px solid #ffffff12;box-shadow:0 15px 50px #0005;backdrop-filter:blur(16px)}
.side{border-radius:22px;padding:14px;height:max-content;position:sticky;top:85px}
.side button{display:block;width:100%;padding:13px;margin:6px 0;border:0;border-radius:12px;background:transparent;color:#b9bfd3;text-align:left;font-weight:700}
.side button:hover,.side button.active{background:linear-gradient(90deg,#ff3cac30,#784cff30);color:white;border:1px solid #ffffff15}
.hero{border-radius:28px;padding:26px;background:linear-gradient(135deg,#ff3cac18,#784cff18,#31e7ff10)}
.tag{color:var(--cyan);font-size:11px;letter-spacing:3px;font-weight:bold}
.hero h1{font-size:clamp(28px,5vw,50px);margin:8px 0}.hero h1 span{color:var(--gold)}
.hero p{color:#9da4bb}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:16px}
.card{border-radius:19px;padding:18px}
.card:hover{transform:translateY(-3px);transition:.2s}
.icon{font-size:25px}.num{font-size:28px;font-weight:900;margin-top:10px}.label{font-size:12px;color:#8e96ad}
.gold{color:var(--gold)}.cyan{color:var(--cyan)}.pink{color:var(--pink)}.green{color:var(--green)}
.section{margin-top:20px}.section h2{margin:0 0 12px}
.modules{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.module{cursor:pointer;min-height:125px}
.module h3{margin:10px 0 5px}.module p{font-size:12px;color:#8e96ad;line-height:1.5}
.panel{display:none;border-radius:22px;padding:20px;margin-top:18px}.panel.show{display:block}
.money{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.money .card{background:linear-gradient(135deg,#1a1630,#11152a)}
.big{font-size:30px;font-weight:900;color:var(--green)}
.bar{height:9px;border-radius:20px;background:#252a40;overflow:hidden;margin-top:10px}
.bar i{display:block;height:100%;width:72%;background:linear-gradient(90deg,var(--pink),var(--purple),var(--cyan))}
button.action{padding:11px 14px;border:0;border-radius:10px;background:linear-gradient(90deg,var(--gold),#ff9f43);font-weight:900;margin:4px;cursor:pointer}
.data{margin-top:12px;border:1px solid #ffffff12;border-radius:14px;padding:14px;overflow:auto}
.row{padding:11px 0;border-bottom:1px solid #ffffff0d}.row:last-child{border:0}.small{color:#8e96ad;font-size:12px}
.badge{display:inline-block;padding:5px 9px;border-radius:20px;background:#31e7ff16;color:var(--cyan);font-size:10px}
@media(max-width:950px){.layout{grid-template-columns:1fr}.side{position:static;display:flex;overflow:auto}.side button{min-width:max-content}.stats,.money{grid-template-columns:repeat(2,1fr)}.modules{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.layout{padding:11px}.stats,.money,.modules{grid-template-columns:1fr}.hero{padding:20px}}

.nav-title{
    margin:18px 8px 7px;
    padding:7px 10px;
    color:#00e5ff;
    font-size:11px;
    font-weight:900;
    letter-spacing:1.4px;
    border-bottom:1px solid rgba(0,229,255,.12);
}

.nav button{
    width:100%;
    text-align:left;
    margin:4px 0;
    padding:12px 13px;
    border:1px solid transparent;
    border-radius:13px;
    background:rgba(255,255,255,.025);
    color:#dce5ff;
    font-size:13px;
    font-weight:700;
    cursor:pointer;
    transition:.2s;
}

.nav button:hover{
    background:linear-gradient(
        90deg,
        rgba(255,20,147,.16),
        rgba(0,229,255,.12)
    );
    border-color:rgba(0,229,255,.25);
    transform:translateX(2px);
}

.nav button.active{
    background:linear-gradient(
        90deg,
        rgba(255,20,147,.28),
        rgba(124,60,255,.25),
        rgba(0,229,255,.16)
    );
    border-color:rgba(0,229,255,.4);
    color:#ffffff;
    box-shadow:0 5px 20px rgba(0,229,255,.08);
}


.active-panel {
    display: block !important;
    animation: ownerPanelIn .22s ease;
}

@keyframes ownerPanelIn {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}


.user-stats {
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:14px;
    margin:20px 0;
}

.stat-card {
    background:linear-gradient(
        145deg,
        rgba(24,31,68,.96),
        rgba(10,14,35,.96)
    );
    border:1px solid rgba(0,229,255,.18);
    border-radius:18px;
    padding:18px;
    box-shadow:0 10px 30px rgba(0,0,0,.2);
}

.stat-card span {
    display:block;
    color:#9ca9ca;
    font-size:12px;
}

.stat-card strong {
    display:block;
    margin-top:8px;
    color:#00e5ff;
    font-size:28px;
}

.user-toolbar {
    display:grid;
    grid-template-columns:2fr 1fr 1fr;
    gap:12px;
    margin:20px 0;
}

.user-toolbar input,
.user-toolbar select {
    box-sizing:border-box;
    width:100%;
    padding:13px;
    border-radius:13px;
    border:1px solid rgba(255,255,255,.12);
    background:#080d24;
    color:white;
    outline:none;
}

.users-table-wrap {
    overflow-x:auto;
    border-radius:18px;
    border:1px solid rgba(0,229,255,.15);
}

.users-table {
    width:100%;
    min-width:850px;
    border-collapse:collapse;
    background:rgba(7,11,30,.8);
}

.users-table th {
    padding:14px;
    text-align:left;
    color:#00e5ff;
    font-size:12px;
    background:rgba(0,229,255,.05);
}

.users-table td {
    padding:14px;
    border-top:1px solid rgba(255,255,255,.06);
    color:#dce5ff;
    font-size:13px;
}

.user-name {
    font-weight:800;
    color:white;
}

.user-sub {
    color:#7885a7;
    font-size:11px;
    margin-top:3px;
}

.role-badge,
.status-badge {
    display:inline-block;
    padding:5px 9px;
    border-radius:20px;
    font-size:11px;
    font-weight:800;
}

.role-customer {
    background:rgba(0,229,255,.1);
    color:#00e5ff;
}

.role-technician {
    background:rgba(124,60,255,.14);
    color:#b98cff;
}

.role-seller {
    background:rgba(255,193,7,.12);
    color:#ffd45c;
}

.status-approved {
    background:rgba(0,255,170,.1);
    color:#00ffb0;
}

.status-pending {
    background:rgba(255,193,7,.1);
    color:#ffd45c;
}

.status-blocked {
    background:rgba(255,40,90,.1);
    color:#ff5c7c;
}

.status-rejected {
    background:rgba(255,40,90,.1);
    color:#ff5c7c;
}

.user-action {
    border:0;
    border-radius:9px;
    padding:7px 10px;
    margin:2px;
    cursor:pointer;
    font-weight:700;
    color:white;
    background:rgba(0,229,255,.1);
}

.user-action:hover {
    background:rgba(0,229,255,.2);
}

.block-action {
    color:#ff6685;
    background:rgba(255,40,90,.08);
}

.loading-cell,
.empty-cell {
    text-align:center;
    padding:35px !important;
    color:#7d89a9 !important;
}

.um-success {
    padding:11px;
    margin:10px 0;
    border-radius:11px;
    background:rgba(0,255,170,.08);
    color:#00ffb0;
}

.um-error {
    padding:11px;
    margin:10px 0;
    border-radius:11px;
    background:rgba(255,40,90,.08);
    color:#ff6685;
}

@media(max-width:800px) {
    .user-stats {
        grid-template-columns:repeat(2,1fr);
    }

    .user-toolbar {
        grid-template-columns:1fr;
    }
}


.master-owner-dashboard {
    margin-bottom: 28px;
}

.master-hero {
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    padding:26px;
    margin-bottom:20px;
    border-radius:24px;
    background:
        linear-gradient(
            135deg,
            rgba(255,20,147,.16),
            rgba(124,60,255,.16),
            rgba(0,229,255,.10)
        );
    border:1px solid rgba(0,229,255,.25);
    box-shadow:0 15px 45px rgba(0,0,0,.25);
}

.master-hero h1 {
    margin:5px 0;
    font-size:28px;
}

.master-hero p {
    margin:0;
    color:#9da9ca;
}

.system-status {
    padding:10px 15px;
    border-radius:30px;
    background:rgba(0,255,170,.08);
    color:#00ffb0;
    font-size:12px;
    font-weight:900;
}

.system-status span {
    text-shadow:0 0 12px #00ffb0;
}

.master-grid {
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:15px;
}

.master-card {
    min-height:145px;
    padding:20px;
    border-radius:20px;
    background:linear-gradient(
        145deg,
        rgba(20,27,60,.98),
        rgba(8,12,31,.98)
    );
    border:1px solid rgba(255,255,255,.08);
    cursor:pointer;
    transition:.22s;
    position:relative;
    overflow:hidden;
}

.master-card::after {
    content:"";
    position:absolute;
    width:100px;
    height:100px;
    right:-35px;
    bottom:-45px;
    border-radius:50%;
    opacity:.15;
    filter:blur(18px);
}

.master-card:hover {
    transform:translateY(-4px);
    border-color:rgba(0,229,255,.4);
    box-shadow:0 15px 35px rgba(0,0,0,.3);
}

.master-icon {
    font-size:30px;
    margin-bottom:8px;
}

.master-card h3 {
    margin:0 0 6px;
    color:#fff;
}

.master-card p {
    margin:0 0 15px;
    color:#8d99ba;
    font-size:12px;
}

.master-card b {
    font-size:11px;
    color:#00e5ff;
}

.master-card.pink { border-top:2px solid #ff1493; }
.master-card.cyan { border-top:2px solid #00e5ff; }
.master-card.purple { border-top:2px solid #9b5cff; }
.master-card.gold { border-top:2px solid #ffd45c; }
.master-card.green { border-top:2px solid #00ffb0; }
.master-card.red { border-top:2px solid #ff5577; }

@media(max-width:950px) {
    .master-grid {
        grid-template-columns:repeat(2,minmax(0,1fr));
    }
}

@media(max-width:600px) {
    .master-hero {
        align-items:flex-start;
        flex-direction:column;
    }

    .master-grid {
        grid-template-columns:1fr;
    }
}


.owner-live-box {
    margin-top:20px;
    padding:20px;
    border-radius:20px;
    background:linear-gradient(
        145deg,
        rgba(18,25,55,.96),
        rgba(7,11,29,.96)
    );
    border:1px solid rgba(0,229,255,.16);
    box-shadow:0 12px 35px rgba(0,0,0,.2);
}

.owner-live-title {
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:15px;
    font-weight:900;
    color:#fff;
}

.live-small {
    color:#00ffb0;
    font-size:10px;
    letter-spacing:1px;
}

.owner-live-box .users-table-wrap {
    max-height:500px;
    overflow:auto;
}

</style>
</head>
