<script id="OWNER ACTION BUTTON ENGINE">

async function ownerAction(endpoint, method="POST", body=null){

    try{

        const options = {
            method: method,
            headers: {
                "Content-Type":"application/json"
            }
        };

        if(body){
            options.body = JSON.stringify(body);
        }

        const response =
            await fetch(endpoint, options);

        const data =
            await response.json();

        if(!response.ok){
            throw new Error(
                data.error || "Action failed"
            );
        }

        alert("✅ " + (
            data.message || "Action successful"
        ));

        if(typeof loadOwnerLiveTables === "function"){
            await loadOwnerLiveTables();
        }

        if(typeof loadOwnerUsers === "function"){
            await loadOwnerUsers();
        }

    }catch(error){

        alert("❌ " + error.message);
    }
}


