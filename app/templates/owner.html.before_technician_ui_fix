function ownerActionButtonsForTable(row, columns) {

    const id = Number(row.id);

    if (!id) {
        return '<span class="small">-</span>';
    }

    const keys = columns.map(c => c.key);

    // USERS
    if (keys.includes("phone") && keys.includes("role")) {

        if (row.role === "owner") {
            return '<span class="status-badge status-approved">OWNER</span>';
        }

        let html = "";

        if (row.status === "pending") {
            html += `
                <button
                    class="owner-action-btn owner-action-green"
                    onclick="ownerUserAction(${id},'approve')">
                    ✅ Approve
                </button>

                <button
                    class="owner-action-btn owner-action-red"
                    onclick="ownerUserAction(${id},'reject')">
                    ❌ Reject
                </button>
            `;
        }

        if (row.status === "blocked") {
            html += `
                <button
                    class="owner-action-btn owner-action-green"
                    onclick="ownerUserAction(${id},'unblock')">
                    🔓 Unblock
                </button>
            `;
        } else {
            html += `
                <button
                    class="owner-action-btn owner-action-red"
                    onclick="ownerUserAction(${id},'block')">
                    🚫 Block
                </button>
            `;
        }

        return html;
    }

    // TECHNICIANS
    if (keys.includes("total_jobs") &&
        keys.includes("completed_jobs")) {

        return `
            <button
                class="owner-action-btn owner-action-purple"
                onclick="panel('technicians');ownerLive('technicians')">
                🛠️ Manage
            </button>
        `;
    }

    // SELLERS
    if (keys.includes("business_name") &&
        keys.includes("products")) {

        return `
            <button
                class="owner-action-btn owner-action-purple"
                onclick="panel('sellers');ownerLive('sellers')">
                🏪 Manage
            </button>
        `;
    }

    // PRODUCTS
    if (keys.includes("approval_status") &&
        keys.includes("seller_name")) {

        if (row.approval_status === "pending") {

            return `
                <button
                    class="owner-action-btn owner-action-green"
                    onclick="ownerProductAction(${id},'approve')">
                    ✅ Approve
                </button>

                <button
                    class="owner-action-btn owner-action-red"
                    onclick="ownerProductAction(${id},'reject')">
                    ❌ Reject
                </button>
            `;
        }

        return `
            <span class="status-badge status-approved">
                ${ownerEscape(row.approval_status)}
            </span>
        `;
    }

    // KYC
    if (keys.includes("document_type") &&
        keys.includes("rejection_reason")) {

        if (row.status === "pending") {

            return `
                <button
                    class="owner-action-btn owner-action-green"
                    onclick="ownerKycAction(${id},'verify')">
                    ✅ Verify
                </button>

                <button
                    class="owner-action-btn owner-action-red"
                    onclick="ownerKycAction(${id},'reject')">
                    ❌ Reject
                </button>
            `;
        }

        return `
            <span class="status-badge">
                ${ownerEscape(row.status)}
            </span>
        `;
    }

    // COMPLAINTS
    if (keys.includes("subject") &&
        keys.includes("priority") &&
        keys.includes("created_at")) {

        if (
            row.status !== "resolved" &&
            row.status !== "closed"
        ) {

            return `
                <button
                    class="owner-action-btn owner-action-green"
                    onclick="ownerComplaintAction(${id},'resolve')">
                    ✅ Resolve
                </button>

                <button
                    class="owner-action-btn owner-action-red"
                    onclick="ownerComplaintAction(${id},'close')">
                    🔒 Close
                </button>
            `;
        }

        return `
            <span class="status-badge status-approved">
                ${ownerEscape(row.status)}
            </span>
        `;
    }

    // REVIEWS
    if (keys.includes("rating") &&
        keys.includes("review")) {

        if (row.status !== "approved") {

            return `
                <button
                    class="owner-action-btn owner-action-green"
                    onclick="ownerReviewAction(${id},'approve')">
                    ✅ Approve
                </button>

                <button
                    class="owner-action-btn owner-action-red"
                    onclick="ownerReviewAction(${id},'hide')">
                    👁️ Hide
                </button>
            `;
        }

        return `
            <button
                class="owner-action-btn owner-action-red"
                onclick="ownerReviewAction(${id},'hide')">
                👁️ Hide
            </button>
        `;
    }

    // ORDERS
    if (keys.includes("total_amount") &&
        keys.includes("order_status")) {

        return `
            <select
                class="owner-action-select"
                onchange="ownerOrderStatus(${id},this.value)">
