<script>

/* =========================================================
   SAWARIYA OWNER FULL LIVE CONTROL ENGINE
   ========================================================= */

const OWNER_LIVE_ENDPOINTS = {
    technicians: ["/owner/master/technicians","technicianLiveData"],
    sellers: ["/owner/master/sellers","sellerLiveData"],
    bookings: ["/owner/master/bookings","bookingLiveData"],
    payments: ["/owner/master/payments","commissionLiveData"],
    orders: ["/owner/master/orders","orderLiveData"],
    products: ["/owner/master/products","marketLiveData"],
    kyc: ["/owner/master/kyc","kycLiveData"],
    complaints: ["/owner/master/complaints","complaintLiveData"],
    reviews: ["/owner/master/reviews","reviewLiveData"],
    support: ["/owner/master/support","supportLiveData"],
    notifications: ["/owner/master/notifications","notificationLiveData"],
    security: ["/owner/master/security","securityLiveData"],
    audit: ["/owner/master/audit","auditLiveData"]
};

function ownerSafe(v){
    return String(v ?? "-")
      .replaceAll("&","&amp;")
      .replaceAll("<","&lt;")
      .replaceAll(">","&gt;")
      .replaceAll('"',"&quot;")
      .replaceAll("'","&#039;");
}

function ownerObjectRows(data){
    if(Array.isArray(data)) return data;

    if(!data || typeof data !== "object") return [];

    for(const key of Object.keys(data)){
        if(Array.isArray(data[key])) return data[key];
    }

    return [];
}

function ownerLiveTable(rows){
    if(!rows.length){
        return '<div class="small">No records found.</div>';
    }

    return `
    <div style="overflow:auto">
    <table style="width:100%;border-collapse:collapse;min-width:650px">
    <thead>
    <tr>
    ${Object.keys(rows[0]).map(k =>
        `<th style="padding:10px;text-align:left;border-bottom:1px solid rgba(255,255,255,.1);color:#8ff">${ownerSafe(k)}</th>`
    ).join("")}
    </tr>
    </thead>
    <tbody>
    ${rows.map(row=>`
      <tr>
      ${Object.keys(rows[0]).map(k =>
        `<td style="padding:10px;border-bottom:1px solid rgba(255,255,255,.06)">
          ${ownerSafe(row[k])}
        </td>`
      ).join("")}
      </tr>
    `).join("")}
    </tbody>
    </table>
    </div>`;
}

async function ownerLive(type){
    const config=OWNER_LIVE_ENDPOINTS[type];
    if(!config) return;

    const [endpoint,boxId]=config;
    const box=document.getElementById(boxId);

    if(!box) return;

    box.innerHTML='<div class="small">⏳ Loading...</div>';

    try{
        const response=await fetch(endpoint,{credentials:"same-origin"});
        const data=await response.json();

        if(!response.ok){
            throw new Error(data.error || "Request failed");
        }

        const rows=ownerObjectRows(data);
        box.innerHTML=ownerLiveTable(rows);

    }catch(e){
        box.innerHTML=
        `<div class="small" style="color:#ff6680">
          ❌ ${ownerSafe(e.message)}
        </div>`;
    }
}

async function loadRefunds(){

    const box=document.getElementById("refundLiveData");

    if(!box) return;

    box.innerHTML='<div class="small">⏳ Loading refunds...</div>';

    try{

        const response=await fetch("/owner/actions/refunds",{
            credentials:"same-origin"
        });

        const data=await response.json();

        if(!response.ok){
            throw new Error(data.error || "Refund loading failed");
        }

        const rows=data.refunds || [];

        if(!rows.length){
            box.innerHTML='<div class="small">💰 No refund records found.</div>';
            return;
        }

        box.innerHTML=rows.map(x=>`
        <div class="row" style="margin-bottom:10px">

          <div><b>Refund #</b> ${ownerSafe(x.id)}</div>
          <div><b>Payment:</b> ${ownerSafe(x.payment_id)}</div>
          <div><b>Booking:</b> ${ownerSafe(x.booking_id)}</div>
          <div><b>Amount:</b> ₹${Number(x.amount||0).toLocaleString("en-IN")}</div>
          <div><b>Reason:</b> ${ownerSafe(x.reason)}</div>
          <div><b>Status:</b> ${ownerSafe(x.status)}</div>

          ${
            String(x.status).toLowerCase()==="pending"
            ? `
            <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">

              <button class="action"
                onclick="ownerRefundAction(${Number(x.id)},'approve')">
                ✅ Approve Refund
              </button>

              <button class="action"
                onclick="ownerRefundAction(${Number(x.id)},'reject')">
                ❌ Reject Refund
              </button>

            </div>`
            : ""
          }

        </div>
        `).join("");

    }catch(e){
        box.innerHTML=
        `<div class="small" style="color:#ff6680">
          ❌ ${ownerSafe(e.message)}
        </div>`;
    }
}

async function ownerRefundAction(id,action){

    if(!confirm(
        action==="approve"
        ? "Refund approve karna hai?"
        : "Refund reject karna hai?"
    )) return;

    try{

        const response=await fetch(
            `/owner/actions/refund/${id}/${action}`,
            {
                method:"POST",
                headers:{"Content-Type":"application/json"},
                credentials:"same-origin"
            }
        );

        const data=await response.json();

        if(!response.ok){
            throw new Error(data.error || "Refund action failed");
        }

        alert(data.message || "Refund updated");
        loadRefunds();

    }catch(e){
        alert(e.message);
    }
}

