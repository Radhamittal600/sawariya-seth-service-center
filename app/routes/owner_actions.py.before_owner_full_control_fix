@owner_actions_bp.post("/product/<int:product_id>/<action>")
@role_required("owner")
def product_action(product_id, action):
    if action not in ("approve", "reject"):
        return jsonify({"error": "Invalid action"}), 400

    owner = get_current_user()
    conn = get_db()

    product = conn.execute("""
        SELECT
            sp.id,
            sp.name,
            sp.seller_id,
            sp.price,
            sp.stock,
            sp.photo_url,
            u.name AS seller_name
        FROM seller_products sp
        LEFT JOIN users u ON u.id = sp.seller_id
        WHERE sp.id=?
    """, (product_id,)).fetchone()

    if not product:
        conn.close()
        return jsonify({"error": "Product not found"}), 404

    status = "approved" if action == "approve" else "rejected"
    active = 1 if action == "approve" else 0

    conn.execute("""
        UPDATE seller_products
        SET approval_status=?, active=?
        WHERE id=?
    """, (status, active, product_id))

    # Notify seller
    if action == "approve":
        title = "✅ PRODUCT APPROVED"
        message = (
            f"Your product '{product['name']}' has been approved by Owner "
            f"and is now LIVE in the marketplace."
        )
    else:
        title = "❌ PRODUCT REJECTED"
        message = (
            f"Your product '{product['name']}' was rejected by Owner. "
            f"Please review the product and submit it again."
        )

    conn.execute("""
        INSERT INTO notifications
        (user_id, title, message, notification_type)
        VALUES (?, ?, ?, ?)
    """, (
        product["seller_id"],
        title,
        message,
        "seller_product_decision"
    ))

    audit(
        conn,
        owner["id"],
        f"product.{action}",
        f"product_id={product_id};seller_id={product['seller_id']};status={status}"
    )

    conn.commit()
    conn.close()

    return jsonify({
        "message": f"Product {action} successful",
        "product_id": product_id,
        "seller_id": product["seller_id"],
        "status": status,
        "active": active
    })


@owner_actions_bp.post("/kyc/<int:kyc_id>/<action>")
@role_required("owner")
def kyc_action(kyc_id, action):
    if action not in ("verify", "reject"):
        return jsonify({"error": "Invalid action"}), 400

    owner = get_current_user()
    conn = get_db()

    document = conn.execute(
        "SELECT id FROM kyc_documents WHERE id=?",
        (kyc_id,)
    ).fetchone()

    if not document:
        conn.close()
        return jsonify({"error": "KYC document not found"}), 404

    status = "verified" if action == "verify" else "rejected"

    conn.execute("""
        UPDATE kyc_documents
        SET status=?,
            verified_by=?,
            verified_at=CURRENT_TIMESTAMP
        WHERE id=?
    """, (status, owner["id"], kyc_id))

    audit(
        conn,
        owner["id"],
        f"kyc.{action}",
        f"kyc_id={kyc_id}"
    )

    conn.commit()
    conn.close()

    return jsonify({
        "message": f"KYC {action} successful",
        "kyc_id": kyc_id,
        "status": status
    })


