@owner_actions_bp.post("/order/<int:order_id>/status")
@role_required("owner")
def order_status(order_id):
    data = request.get_json(silent=True) or {}
    status = str(data.get("status", "")).strip().lower()

    allowed = {
        "pending",
        "confirmed",
        "processing",
        "shipped",
        "delivered",
        "cancelled"
    }

    if status not in allowed:
        return jsonify({"error": "Invalid order status"}), 400

    owner = get_current_user()
    conn = get_db()

    order = conn.execute(
        "SELECT id FROM orders WHERE id=?",
        (order_id,)
    ).fetchone()

    if not order:
        conn.close()
        return jsonify({"error": "Order not found"}), 404

    conn.execute("""
        UPDATE orders
        SET order_status=?
        WHERE id=?
    """, (status, order_id))

    audit(
        conn,
        owner["id"],
        "order.status_update",
        f"order_id={order_id},status={status}"
    )

    conn.commit()
    conn.close()

    return jsonify({
        "message": "Order status updated",
        "order_id": order_id,
        "status": status
    })
